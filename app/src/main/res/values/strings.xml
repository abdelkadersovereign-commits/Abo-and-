    <!-- Supplications (Kept for reference, but new structure in ViewModel is primary) -->
    <string name="morning_supplication_1_content">أَصْبَحْنَا وَأَصْبَحَ الْمُلْكُ لِلَّهِ وَالْحَمْدُ لِلَّهِ، لَا إِلَهَ إِلَّا اللَّهُ وَحْدَهُ لَا شَرِيكَ لَهُ، لَهُ الْمُلْكُ وَلَهُ الْحَمْدُ وَهُوَ عَلَى كُلِّ شَيْءٍ قَدِيرٌ.</string>
    <string name="morning_supplication_1_translation">We have reached the morning and at this very time all sovereignty belongs to Allah, and all praise is for Allah. There is no god but Allah, alone, without partner. To Him belongs the dominion, and to Him belongs all praise, and He is able to do all things.</string>
    <string name="morning_supplication_1_resonance">Sovereign Alignment</string>

    <string name="evening_supplication_1_content">أَمْسَيْنَا وَأَمْسَى الْمُلْكُ لِلَّهِ وَالْحَمْدُ لِلَّهِ، لَا إِلَهَ إِلَّا اللَّهُ وَحْدَهُ لَا شَرِيكَ لَهُ، لَهُ الْمُلْكُ وَلَهُ الْحَمْدُ وَهُوَ عَلَى كُلِّ شَيْءٍ قَدِيرٌ.</string>
    <string name="evening_supplication_1_translation">We have reached the evening and at this very time all sovereignty belongs to Allah, and all praise is for Allah. There is no god but Allah, alone, without partner. To Him belongs the dominion, and to Him belongs all praise, and He is able to do all things.</string>
    <string name="evening_supplication_1_resonance">Sovereign Alignment</string>

    <string name="soul_calming_supplication_1_content">يَا حَيُّ يَا قَيُّومُ بِرَحْمَتِكَ أَسْتَغِيثُ، أَصْلِحْ لِي شَأْنِي كُلَّهُ، وَلَا تَكِلْنِي إِلَى نَفْسِي طَرْفَةَ عَيْنٍ.</string>
    <string name="soul_calming_supplication_1_translation">O Ever-Living, O Sustainer, by Your mercy I seek help. Rectify for me all my affairs and do not leave me to myself, even for the blink of an eye.</string>
    <string name="soul_calming_supplication_1_resonance">Deep Sanctuary</string>

    <string name="misc_supplication_1_content">لَا إِلَهَ إِلَّا أَنْتَ سُبْحَانَكَ إِنِّي كُنْتُ مِنَ الظَّالِمِينَ.</string>
    <string name="misc_supplication_1_translation">There is no deity except You; exalted are You. Indeed, I have been of the wrongdoers.</string>
    <string name="misc_supplication_1_resonance">Ego Dissolution</string>
    
